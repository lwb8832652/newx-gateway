# newx-gateway 配置示例
# 用法：cp .env.example .env && 按需修改
# 加载方式：./newx-gateway --env-file .env   （已存在的进程环境变量优先，不会被文件覆盖）
#
# 说明：本阶段为脚手架，标注「预留」的配置会被解析与校验，但尚未参与转发逻辑。

# ---------- 进程 ----------
# 监听地址，host:port
ENTRY_HTTP_ADDR=:8080
# 运行环境：dev | production。production 下禁止开启鉴权桩（启动即失败）
ENTRY_ENV=dev
# 版本号，构建时可用 -ldflags "-X main.version=..." 覆盖
ENTRY_VERSION=dev
# 收到退出信号后等待在途请求结束的最长时间
ENTRY_EXIT_WAIT_TIME=10s

# ---------- 应用注册 ----------
# 条目语法：code=地址[,code=地址...]
#   静态地址      code=http://host:port
#   注册中心服务   code=nacos://service-name
#   上游路径改写   任意形式后接 |/upstream-path（入口剥掉自身前缀后，再拼它转发）
# 例：入口 /admin/yudao-system/v1/user/page → 上游 /admin-api/system/user/page
# app_code 规则：小写字母开头，允许小写字母/数字/连字符，长度 2-32
APPS=huobao=http://127.0.0.1:5679|/api/v1
# 未在 APPS 中显式给出地址时，huobao 的默认下游地址
HUOBAO_BASE_URL=http://127.0.0.1:5679

# ---------- 服务发现 ----------
# 留空 = 全部使用静态地址（推荐先用这种跑通）
# 形如 nacos://host:port，不带 /nacos；APPS 中填 nacos://service-name（可不同于 app_code）
# 仅通过 HTTP 开放 API 读取实例；不自动注册业务服务，不支持 Nacos 登录或 accessToken 续期。
# 真实 Nacos 2.4.0 无鉴权联调记录见 README；请使用可信网络，不将无鉴权接口暴露到公网。
DISCOVERY=
# 命名空间 ID，留空表示 public
# DISCOVERY_NAMESPACE=
# DISCOVERY_GROUP=DEFAULT_GROUP
# 后台刷新周期，同时作为本地缓存 TTL；拉取失败保留旧缓存，成功空列表覆盖旧缓存
# 真实联调使用 1s，默认仍为 5s
DISCOVERY_REFRESH=5s

# ---------- 通道开关 ----------
MCP_ENABLED=true
OPENAPI_ENABLED=false

# ---------- 认证（沿用 yudao-cloud 网关的方式）----------
# 开启后入口用「远程校验 + 注入 login-user 头」替代本地 JWT 校验：
# 有 Bearer Token 才校验，校验成功把 LoginUser（JSON + URL-encode，
# expiresTime 为 epoch 毫秒数字）写入 login-user 头，可信租户覆盖 tenant-id。
# tenant-id 本身只是客户端租户选择提示，合法非负整数可传给 check-token；
# 无 Token / 校验失败 / 鉴权方不可用均保留提示、不带身份放行。
# login-user 永远剥离后重建，是否需要登录及权限判断由下游服务负责。
AUTH_ENABLED=false
# 鉴权方来源二选一：AUTH_APP_CODE 走 APPS 注册表（可配 nacos:// 服务发现），
# 或 AUTH_BASE_URL 静态地址。两者不能同时配置。
# AUTH_APP_CODE=yudao-system
# AUTH_BASE_URL=http://127.0.0.1:9099
# 令牌校验接口路径（默认 /system-api/oauth2/check-token）
AUTH_CHECK_PATH=/system-api/oauth2/check-token
# 登录用户本地缓存时长，默认 1 分钟（与 yudao 网关一致）；失败不写缓存
AUTH_CACHE_TTL=1m
# 单次校验超时
AUTH_TIMEOUT=3s

# ---------- 请求体限制 ----------
# 普通请求体上限（字节）
MAX_BODY_BYTES=1048576
# 上传通道上限（字节）：命中下方 TIMEOUT_UPLOAD_PATHS 的路径用这个上限，
# 其余路径用 MAX_BODY_BYTES。协议层也以此为兜底。
MAX_BODY_BYTES_UPLOAD=2147483648

# ---------- 超时分级（已生效）----------
# 按请求类型选档：GET/HEAD/OPTIONS 读 TIMEOUT_READ，写方法 TIMEOUT_WRITE，
# 命中 TIMEOUT_GENERATE_PATHS 用 TIMEOUT_GENERATE，命中 TIMEOUT_UPLOAD_PATHS 用 TIMEOUT_UPLOAD。
# 家族级覆盖优先：MCP 通道固定用 TIMEOUT_MCP。
TIMEOUT_READ=15s
TIMEOUT_WRITE=60s
TIMEOUT_GENERATE=900s
TIMEOUT_UPLOAD=1800s
TIMEOUT_STATIC=300s
TIMEOUT_MCP=60s
# 生成类路径片段（逗号分隔，子串匹配）
TIMEOUT_GENERATE_PATHS=/agent,/tasks,/merge,/previs,/task-queue
# 上传类路径片段（同时决定体积上限豁免）
TIMEOUT_UPLOAD_PATHS=/upload

# ---------- 失败熔断 ----------
# 某实例连续失败达到阈值后，冷却期内不再被选中（静态地址场景尤其重要）；
# 冷却结束自动放行试探请求，成功即恢复。传输层失败与下游 5xx 都计入失败。
BREAKER_ENABLED=true
BREAKER_FAIL_THRESHOLD=5
BREAKER_COOLDOWN=10s

# ---------- 重试（固定策略，无开关）----------
# 幂等方法（GET/HEAD/OPTIONS）在拨号失败或超时时，最多换实例重试 1 次；无备用实例不重试。
# 写方法不自动重试；已知缺口：尚未排除生成类 GET 等方法，不能依赖入口保证业务去重。

# ---------- 限流与生成并发（按当前需求暂缓，仅解析配置，不执行拦截）----------
RATE_WEB=120
RATE_WEB_GENERATE=10
RATE_ADMIN=300
RATE_MCP=60
MAX_CONCURRENCY_GENERATE=32

# ---------- 观测 ----------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
# 就绪检查是否探测下游；默认关闭，避免下游抖动导致入口被摘
READYZ_PROBE_DOWNSTREAM=false
# 是否信任客户端 X-Forwarded-For；仅当前方有可信代理时开启
TRUST_PROXY_HEADERS=false
