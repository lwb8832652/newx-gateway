# newx-gateway 配置示例
# 用法：cp .env.example .env && 按需修改
# 加载方式：./newx-gateway --env-file .env   （已存在的进程环境变量优先，不会被文件覆盖）
#
# 说明：本阶段为脚手架，标注「预留」的配置会被解析与校验，但尚未参与转发逻辑。

# ---------- 进程 ----------
# 监听地址，host:port
ENTRY_HTTP_ADDR=:8080
# 运行环境：dev | production。production 下禁止开启鉴权桩（启动即失败）
ENTRY_ENV=dev
# 版本号，构建时可用 -ldflags "-X main.version=..." 覆盖
ENTRY_VERSION=dev
# 收到退出信号后等待在途请求结束的最长时间
ENTRY_EXIT_WAIT_TIME=10s

# ---------- 应用注册 ----------
# 格式：code=base_url，多个用逗号分隔；只写 code 表示地址待接入
# app_code 规则：小写字母开头，允许小写字母/数字/连字符，长度 2-32
APPS=huobao=http://127.0.0.1:5679
# 未在 APPS 中显式给出地址时，huobao 的默认下游地址
HUOBAO_BASE_URL=http://127.0.0.1:5679

# ---------- 通道开关 ----------
MCP_ENABLED=true
OPENAPI_ENABLED=false

# ---------- 鉴权（预留，本阶段不生效）----------
# 鉴权方地址：本阶段为 authstub，后续替换为 Admin Service
AUTH_ISSUER_BASE_URL=http://127.0.0.1:9099
# 内置签发桩开关，仅限 dev/CI；production 下为 true 会拒绝启动
AUTH_STUB_ENABLED=false

# ---------- 请求体限制 ----------
# 普通请求体上限（字节）
MAX_BODY_BYTES=1048576
# 上传通道上限（字节），预留
MAX_BODY_BYTES_UPLOAD=2147483648

# ---------- 超时分级（预留，本阶段不生效）----------
TIMEOUT_READ=15s
TIMEOUT_WRITE=60s
TIMEOUT_GENERATE=900s
TIMEOUT_UPLOAD=1800s
TIMEOUT_STATIC=300s
TIMEOUT_MCP=60s

# ---------- 限流（预留，本阶段不生效）----------
RATE_WEB=120
RATE_WEB_GENERATE=10
RATE_ADMIN=300
RATE_MCP=60
MAX_CONCURRENCY_GENERATE=32

# ---------- 观测 ----------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
# 就绪检查是否探测下游；默认关闭，避免下游抖动导致入口被摘
READYZ_PROBE_DOWNSTREAM=false
# 是否信任客户端 X-Forwarded-For；仅当前方有可信代理时开启
TRUST_PROXY_HEADERS=false
